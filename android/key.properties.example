# Template for android/key.properties (production upload signing).
#
# Copy to android/key.properties and fill in real values. That file is
# git-ignored and must never be committed, shared or uploaded to CI.
# See docs/ANDROID_SIGNING.md.
storePassword=<keystore password>
keyPassword=<key password>
keyAlias=upload
# Absolute path, or relative to android/app/. Keep the keystore outside the
# repository.
storeFile=/absolute/path/outside/the/repo/nextrep-upload.jks
