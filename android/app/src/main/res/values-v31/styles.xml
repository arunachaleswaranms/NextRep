<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the adaptive launcher icon on the app's
         night background. It stays only until Flutter's first frame; there
         is no artificial delay. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/nextrep_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/nextrep_background</item>
    </style>
</resources>
