    {
      "name": "winter_arc_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"winter_arc_sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"start_date\" TEXT NOT NULL, \"end_date\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"started_at\" INTEGER NULL, \"arc_kind\" TEXT NOT NULL DEFAULT 'rolling92', \"participation_start_date\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"session_id\" INTEGER NOT NULL REFERENCES winter_arc_sessions (id) ON DELETE CASCADE, \"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"target\" INTEGER NOT NULL CHECK(\"target\" > 0), \"unit\" TEXT NULL, \"icon_key\" TEXT NOT NULL, \"enabled\" INTEGER NOT NULL CHECK (\"enabled\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"minimum_target\" INTEGER NOT NULL DEFAULT 1 CHECK(\"minimum_target\" BETWEEN 1 AND \"target\"), PRIMARY KEY (\"session_id\", \"id\"));"
        }
      ]
    },
    {
      "name": "daily_habit_progress_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_habit_progress_entries\" (\"session_id\" INTEGER NOT NULL, \"habit_id\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"current_value\" INTEGER NOT NULL CHECK(\"current_value\" >= 0), \"completed\" INTEGER NOT NULL CHECK (\"completed\" IN (0, 1)), \"completed_at\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"session_id\", \"habit_id\", \"date\"), FOREIGN KEY (session_id, habit_id) REFERENCES habits (session_id, id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "xp_transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"xp_transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES winter_arc_sessions (id) ON DELETE CASCADE, \"source_key\" TEXT NOT NULL, \"reason\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL, \"habit_id\" TEXT NULL, \"date\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, UNIQUE (\"session_id\", \"source_key\"));"
        }
      ]
    },
    {
      "name": "habit_revisions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_revisions\" (\"session_id\" INTEGER NOT NULL, \"habit_id\" TEXT NOT NULL, \"effective_from\" TEXT NOT NULL, \"target\" INTEGER NOT NULL CHECK(\"target\" > 0), \"minimum_target\" INTEGER NOT NULL CHECK(\"minimum_target\" BETWEEN 1 AND \"target\"), \"enabled\" INTEGER NOT NULL CHECK (\"enabled\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"session_id\", \"habit_id\", \"effective_from\"), FOREIGN KEY (session_id, habit_id) REFERENCES habits (session_id, id) ON DELETE CASCADE);"
        }
      ]
    },
